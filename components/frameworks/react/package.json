{
  "name": "@omnibase/mitosis-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React output generated by Mitosis from @omnibase/mitosis.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "bun run --filter @omnibase/mitosis build",
    "storybook": "bun run generate && bun run storybook:only",
    "storybook:only": "storybook dev -p 6008",
    "build-storybook": "bun run generate && storybook build"
  },
  "dependencies": {
    "@omnibase/mitosis-storybook": "workspace:*",
    "basecoat-css": "^1.0.2"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "storybook": "10.6.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
