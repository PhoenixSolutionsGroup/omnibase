{
  "name": "@omnibase/mitosis-alpine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Alpine.js output generated by Mitosis from @omnibase/mitosis. No Storybook renderer exists; see the standalone Vite dev app.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "bun run --filter @omnibase/mitosis build",
    "dev": "bun run generate && vite --port 5176 --strictPort",
    "build": "bun run generate && vite build",
    "preview": "vite preview --port 5176 --strictPort"
  },
  "dependencies": {
    "@omnibase/mitosis-storybook": "workspace:*",
    "alpinejs": "^3.14.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.0"
  }
}
