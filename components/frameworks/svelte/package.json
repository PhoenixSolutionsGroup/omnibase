{
  "name": "@omnibase/mitosis-svelte",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Svelte output generated by Mitosis from @omnibase/mitosis.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "bun run --filter @omnibase/mitosis build",
    "dev": "bun run generate && vite --port 5175 --strictPort",
    "build": "bun run generate && vite build",
    "preview": "vite preview --port 5175 --strictPort",
    "storybook": "bun run generate && bun run storybook:only",
    "storybook:only": "storybook dev -p 6010",
    "build-storybook": "bun run generate && storybook build"
  },
  "dependencies": {
    "@omnibase/mitosis-storybook": "workspace:*",
    "basecoat-css": "^1.0.2",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.1",
    "@storybook/svelte-vite": "10.6.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "storybook": "10.6.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
