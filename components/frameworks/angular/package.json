{
  "name": "@omnibase/mitosis-angular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Angular output generated by Mitosis from @omnibase/mitosis.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "bun run --filter @omnibase/mitosis build",
    "storybook": "bun run generate && bun run storybook:only",
    "storybook:only": "storybook dev -p 6013",
    "build-storybook": "bun run generate && storybook build"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@omnibase/mitosis-storybook": "workspace:*",
    "basecoat-css": "^1.0.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular-devkit/architect": ">=0.2100.0 <0.2300.0",
    "@angular-devkit/core": "^21.2.24",
    "@angular/animations": "^21.2.0",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/angular-vite": "10.6.1",
    "@tailwindcss/vite": "^4.1.18",
    "storybook": "10.6.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
