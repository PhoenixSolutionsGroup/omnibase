{
  "name": "@omnibase/mitosis-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Head Storybook for the OmniBase Mitosis component library. Composes the per-framework Storybooks and holds shared fixtures and styles.",
  "exports": {
    "./mock-data": {
      "types": "./src/mock-data.ts",
      "import": "./src/mock-data.ts"
    },
    "./styles.css": "./src/styles.css",
    "./custom-css-bridge": {
      "types": "./src/custom-css-bridge.ts",
      "import": "./src/custom-css-bridge.ts"
    }
  },
  "scripts": {
    "dev": "bash ./scripts/dev.sh",
    "storybook": "storybook dev -p 6007",
    "storybook:only": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "basecoat-css": "^1.0.2"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "^4.1.18",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "storybook": "10.6.1",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.0"
  }
}
