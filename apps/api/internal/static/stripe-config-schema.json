{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omnibase.dev/schemas/stripe-config.json",
  "title": "Stripe Configuration Schema",
  "description": "Schema for Stripe product and pricing configuration",
  "type": "object",
  "required": [
    "version",
    "products"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Configuration version in semantic versioning format"
    },
    "webhooks": {
      "type": "array",
      "description": "List of webhook endpoint configurations",
      "items": {
        "$ref": "#/definitions/WebhookEndpointConfig"
      }
    },
    "meters": {
      "type": "array",
      "description": "List of billing meters for metered pricing (required when any price uses usage_type metered)",
      "items": {
        "$ref": "#/definitions/Meter"
      }
    },
    "products": {
      "type": "array",
      "description": "List of products with their prices",
      "items": {
        "$ref": "#/definitions/Product"
      }
    }
  },
  "definitions": {
    "CurrencyCode": {
      "type": "string",
      "description": "Three-letter ISO currency code (lowercase)",
      "enum": [
        "usd",
        "eur",
        "gbp",
        "cad",
        "aud",
        "jpy",
        "inr",
        "brl",
        "mxn",
        "sgd",
        "hkd",
        "nzd",
        "chf",
        "sek",
        "dkk",
        "nok",
        "pln",
        "czk",
        "ils",
        "zar"
      ]
    },
    "BillingInterval": {
      "type": "string",
      "description": "Billing interval for recurring prices",
      "enum": [
        "day",
        "week",
        "month",
        "year"
      ]
    },
    "UsageType": {
      "type": "string",
      "description": "Usage type for recurring prices",
      "enum": [
        "licensed",
        "metered"
      ]
    },
    "PerUnitBillingScheme": {
      "type": "string",
      "description": "Billing scheme type for per-unit pricing",
      "enum": [
        "per_unit"
      ],
      "default": "per_unit"
    },
    "TieredBillingScheme": {
      "type": "string",
      "description": "Billing scheme type for tiered pricing",
      "enum": [
        "tiered"
      ]
    },
    "TiersMode": {
      "type": "string",
      "description": "Tiers mode for tiered pricing",
      "enum": [
        "graduated",
        "volume"
      ]
    },
    "StripeConfiguration": {
      "type": "object",
      "required": [
        "version",
        "products"
      ],
      "properties": {
        "version": {
          "type": "string",
          "description": "Configuration version in semantic versioning format"
        },
        "webhooks": {
          "type": "array",
          "description": "List of webhook endpoint configurations",
          "items": {
            "$ref": "#/definitions/WebhookEndpointConfig"
          }
        },
        "meters": {
          "type": "array",
          "description": "List of billing meters for metered pricing (required when any price uses usage_type metered)",
          "items": {
            "$ref": "#/definitions/Meter"
          }
        },
        "products": {
          "type": "array",
          "description": "List of products with their prices",
          "items": {
            "$ref": "#/definitions/Product"
          }
        }
      }
    },
    "StripeConfigurationWithIDs": {
      "type": "object",
      "required": [
        "version",
        "products"
      ],
      "properties": {
        "version": {
          "type": "string",
          "description": "Configuration version"
        },
        "webhooks": {
          "type": "array",
          "description": "List of webhook endpoint configurations",
          "items": {
            "$ref": "#/definitions/WebhookEndpointConfig"
          }
        },
        "meters": {
          "type": "array",
          "description": "List of billing meters with Stripe IDs",
          "items": {
            "$ref": "#/definitions/MeterWithStripeID"
          }
        },
        "products": {
          "type": "array",
          "description": "List of products with Stripe IDs",
          "items": {
            "$ref": "#/definitions/ProductWithStripeIDs"
          }
        }
      }
    },
    "Product": {
      "type": "object",
      "required": [
        "id",
        "name",
        "prices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Product identifier (config ID)"
        },
        "stripe_id": {
          "type": "string",
          "description": "Original Stripe ID for migration support (optional, used to link existing Stripe products)"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Product name"
        },
        "description": {
          "type": "string",
          "description": "Product description"
        },
        "type": {
          "type": "string",
          "description": "Product type",
          "enum": [
            "service",
            "good"
          ]
        },
        "prices": {
          "type": "array",
          "minItems": 1,
          "description": "List of prices for this product",
          "items": {
            "$ref": "#/definitions/Price"
          }
        },
        "ui": {
          "$ref": "#/definitions/ProductUI"
        }
      }
    },
    "ProductWithStripeIDs": {
      "type": "object",
      "required": [
        "id",
        "name",
        "prices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Product identifier (config ID)"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Product name"
        },
        "description": {
          "type": "string",
          "description": "Product description"
        },
        "type": {
          "type": "string",
          "description": "Product type",
          "enum": [
            "service",
            "good"
          ]
        },
        "prices": {
          "type": "array",
          "minItems": 1,
          "description": "List of prices with Stripe IDs",
          "items": {
            "$ref": "#/definitions/PriceWithStripeID"
          }
        },
        "ui": {
          "$ref": "#/definitions/ProductUI"
        },
        "stripe_id": {
          "type": "string",
          "nullable": true,
          "description": "Actual Stripe product ID (null for free products)"
        }
      }
    },
    "Price": {
      "oneOf": [
        {
          "$ref": "#/definitions/PerUnitPrice"
        },
        {
          "$ref": "#/definitions/TieredPrice"
        }
      ]
    },
    "PerUnitPrice": {
      "type": "object",
      "required": [
        "id",
        "currency",
        "amount"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Price identifier (config ID)"
        },
        "stripe_id": {
          "type": "string",
          "description": "Original Stripe ID for migration support (optional, used to link existing Stripe prices)"
        },
        "public": {
          "type": "boolean",
          "nullable": true,
          "description": "Whether price is visible in public API (null/true = public, false = enterprise only)"
        },
        "tax_included_in_price": {
          "type": "boolean",
          "nullable": true,
          "description": "Whether tax is included in the price (null/false = exclusive)"
        },
        "amount": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "description": "Price amount (supports decimals for sub-cent hourly pricing)"
        },
        "currency": {
          "$ref": "#/definitions/CurrencyCode"
        },
        "interval": {
          "allOf": [
            {
              "$ref": "#/definitions/BillingInterval"
            },
            {
              "description": "Billing interval for recurring prices (required when usage_type is metered)"
            }
          ]
        },
        "interval_count": {
          "type": "integer",
          "description": "Number of intervals between billings (default 1)"
        },
        "usage_type": {
          "allOf": [
            {
              "$ref": "#/definitions/UsageType"
            },
            {
              "description": "Usage type for recurring prices (when set to metered, interval and meter are required)"
            }
          ]
        },
        "meter": {
          "type": "string",
          "minLength": 1,
          "description": "Meter ID for metered pricing (required when usage_type is metered, must reference a meter defined in the meters array)"
        },
        "billing_scheme": {
          "$ref": "#/definitions/PerUnitBillingScheme"
        },
        "default": {
          "type": "boolean",
          "description": "Mark as default price for the product"
        },
        "enterprise_template": {
          "type": "string",
          "description": "Enterprise template group for shared pricing tiers"
        },
        "enterprise_id": {
          "type": "string",
          "description": "Enterprise pricing group ID for tenant-specific pricing"
        },
        "ui": {
          "$ref": "#/definitions/PriceUI"
        }
      },
      "if": {
        "properties": {
          "usage_type": {
            "const": "metered"
          }
        },
        "required": [
          "usage_type"
        ]
      },
      "then": {
        "required": [
          "interval",
          "meter"
        ]
      }
    },
    "TieredPrice": {
      "type": "object",
      "required": [
        "id",
        "currency",
        "billing_scheme",
        "tiers_mode",
        "tiers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Price identifier (config ID)"
        },
        "stripe_id": {
          "type": "string",
          "description": "Original Stripe ID for migration support (optional, used to link existing Stripe prices)"
        },
        "public": {
          "type": "boolean",
          "nullable": true,
          "description": "Whether price is visible in public API (null/true = public, false = enterprise only)"
        },
        "tax_included_in_price": {
          "type": "boolean",
          "nullable": true,
          "description": "Whether tax is included in the price (null/false = exclusive)"
        },
        "currency": {
          "$ref": "#/definitions/CurrencyCode"
        },
        "interval": {
          "allOf": [
            {
              "$ref": "#/definitions/BillingInterval"
            },
            {
              "description": "Billing interval for recurring prices (required when usage_type is metered)"
            }
          ]
        },
        "interval_count": {
          "type": "integer",
          "description": "Number of intervals between billings (default 1)"
        },
        "usage_type": {
          "allOf": [
            {
              "$ref": "#/definitions/UsageType"
            },
            {
              "description": "Usage type for recurring prices (when set to metered, interval and meter are required)"
            }
          ]
        },
        "meter": {
          "type": "string",
          "minLength": 1,
          "description": "Meter ID for metered pricing (required when usage_type is metered, must reference a meter defined in the meters array)"
        },
        "billing_scheme": {
          "$ref": "#/definitions/TieredBillingScheme"
        },
        "tiers_mode": {
          "$ref": "#/definitions/TiersMode"
        },
        "tiers": {
          "type": "array",
          "description": "Pricing tiers",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Tier"
          }
        },
        "default": {
          "type": "boolean",
          "description": "Mark as default price for the product"
        },
        "enterprise_template": {
          "type": "string",
          "description": "Enterprise template group for shared pricing tiers"
        },
        "enterprise_id": {
          "type": "string",
          "description": "Enterprise pricing group ID for tenant-specific pricing"
        },
        "ui": {
          "$ref": "#/definitions/PriceUI"
        }
      },
      "if": {
        "properties": {
          "usage_type": {
            "const": "metered"
          }
        },
        "required": [
          "usage_type"
        ]
      },
      "then": {
        "required": [
          "interval",
          "meter"
        ]
      }
    },
    "PriceWithStripeID": {
      "type": "object",
      "required": [
        "id",
        "currency"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Price identifier (config ID)"
        },
        "public": {
          "type": "boolean",
          "nullable": true,
          "description": "Whether price is visible in public API"
        },
        "tax_included_in_price": {
          "type": "boolean",
          "nullable": true,
          "description": "Whether tax is included in the price"
        },
        "amount": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "description": "Price amount (supports decimals for sub-cent hourly pricing)"
        },
        "currency": {
          "$ref": "#/definitions/CurrencyCode"
        },
        "interval": {
          "$ref": "#/definitions/BillingInterval"
        },
        "interval_count": {
          "type": "integer",
          "description": "Number of intervals between billings"
        },
        "usage_type": {
          "$ref": "#/definitions/UsageType"
        },
        "meter": {
          "type": "string",
          "description": "Meter ID for metered pricing"
        },
        "billing_scheme": {
          "type": "string",
          "nullable": true,
          "description": "Billing scheme type"
        },
        "tiers_mode": {
          "type": "string",
          "nullable": true,
          "description": "Tiers mode"
        },
        "tiers": {
          "type": "array",
          "description": "Pricing tiers",
          "items": {
            "$ref": "#/definitions/Tier"
          }
        },
        "default": {
          "type": "boolean",
          "description": "Mark as default price"
        },
        "enterprise_template": {
          "type": "string",
          "description": "Enterprise template group for shared pricing tiers"
        },
        "enterprise_id": {
          "type": "string",
          "description": "Enterprise pricing group ID for tenant-specific pricing"
        },
        "ui": {
          "$ref": "#/definitions/PriceUI"
        },
        "stripe_id": {
          "type": "string",
          "nullable": true,
          "description": "Actual Stripe price ID (null for free prices)"
        }
      }
    },
    "Tier": {
      "type": "object",
      "properties": {
        "up_to": {
          "oneOf": [
            {
              "type": "integer",
              "description": "Upper limit of this tier"
            },
            {
              "type": "string",
              "enum": [
                "inf"
              ],
              "description": "Infinite tier (last tier)"
            }
          ]
        },
        "flat_amount": {
          "type": "integer",
          "format": "int64",
          "nullable": true,
          "description": "Flat fee for this tier"
        },
        "unit_amount": {
          "type": "integer",
          "format": "int64",
          "nullable": true,
          "description": "Per-unit price for this tier"
        }
      }
    },
    "Meter": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "event_name",
        "default_aggregation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Meter identifier (config ID)"
        },
        "stripe_id": {
          "type": "string",
          "description": "Original Stripe ID for migration support (optional, used to link existing Stripe meters)"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable meter name"
        },
        "event_name": {
          "type": "string",
          "minLength": 1,
          "description": "Event name to track for this meter"
        },
        "default_aggregation": {
          "$ref": "#/definitions/MeterDefaultAggregation"
        },
        "customer_mapping": {
          "$ref": "#/definitions/MeterCustomerMapping"
        },
        "value_settings": {
          "$ref": "#/definitions/MeterValueSettings"
        }
      }
    },
    "MeterWithStripeID": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "event_name",
        "default_aggregation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Meter identifier (config ID)"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable meter name"
        },
        "event_name": {
          "type": "string",
          "minLength": 1,
          "description": "Event name to track"
        },
        "default_aggregation": {
          "$ref": "#/definitions/MeterDefaultAggregation"
        },
        "customer_mapping": {
          "$ref": "#/definitions/MeterCustomerMapping"
        },
        "value_settings": {
          "$ref": "#/definitions/MeterValueSettings"
        },
        "stripe_id": {
          "type": "string",
          "nullable": true,
          "description": "Actual Stripe meter ID"
        }
      }
    },
    "MeterDefaultAggregation": {
      "type": "object",
      "required": [
        "formula"
      ],
      "properties": {
        "formula": {
          "type": "string",
          "description": "Aggregation formula for meter events",
          "enum": [
            "sum",
            "count",
            "last"
          ]
        }
      }
    },
    "MeterCustomerMapping": {
      "type": "object",
      "required": [
        "event_payload_key",
        "type"
      ],
      "properties": {
        "event_payload_key": {
          "type": "string",
          "minLength": 1,
          "description": "Key in event payload to identify customer (must be different from value_settings.event_payload_key)"
        },
        "type": {
          "type": "string",
          "description": "Mapping type",
          "enum": [
            "by_id"
          ]
        }
      }
    },
    "MeterValueSettings": {
      "type": "object",
      "required": [
        "event_payload_key"
      ],
      "properties": {
        "event_payload_key": {
          "type": "string",
          "minLength": 1,
          "description": "Key in event payload containing the usage value (must be different from customer_mapping.event_payload_key)"
        }
      }
    },
    "ProductUI": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "description": "Display name for UI"
        },
        "tagline": {
          "type": "string",
          "description": "Short tagline"
        },
        "features": {
          "type": "array",
          "description": "List of product features",
          "items": {
            "type": "string"
          }
        },
        "badge": {
          "type": "string",
          "description": "Badge text (e.g., \"Popular\", \"Best Value\")"
        },
        "cta_text": {
          "type": "string",
          "description": "Call-to-action button text"
        },
        "highlighted": {
          "type": "boolean",
          "description": "Whether to highlight this product"
        },
        "sort_order": {
          "type": "integer",
          "description": "Display order for sorting"
        }
      }
    },
    "PriceUI": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "description": "Display name for this price tier"
        },
        "price_display": {
          "$ref": "#/definitions/PriceDisplay"
        },
        "billing_period": {
          "type": "string",
          "description": "Human-readable billing period"
        },
        "features": {
          "type": "array",
          "description": "Features specific to this price",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "array",
          "description": "Usage limits for this price",
          "items": {
            "$ref": "#/definitions/PriceLimit"
          }
        }
      }
    },
    "PriceDisplay": {
      "type": "object",
      "properties": {
        "custom_text": {
          "type": "string",
          "description": "Custom text to display instead of price"
        },
        "show_currency": {
          "type": "boolean",
          "nullable": true,
          "description": "Whether to show currency symbol"
        },
        "suffix": {
          "type": "string",
          "description": "Text to append after price"
        }
      }
    },
    "PriceLimit": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Limit description"
        },
        "value": {
          "type": "number",
          "format": "double",
          "nullable": true,
          "description": "Numeric limit value"
        },
        "unit": {
          "type": "string",
          "description": "Unit of measurement"
        }
      }
    },
    "StripeConfigResponse": {
      "type": "object",
      "required": [
        "id",
        "config",
        "version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Configuration ID"
        },
        "config": {
          "$ref": "#/definitions/StripeConfigurationWithIDs"
        },
        "version": {
          "type": "string",
          "description": "Configuration version"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      }
    },
    "ConfigHistoryResponse": {
      "type": "object",
      "required": [
        "configs",
        "pagination"
      ],
      "properties": {
        "configs": {
          "type": "array",
          "description": "List of configuration entries",
          "items": {
            "$ref": "#/definitions/ConfigHistoryItem"
          }
        },
        "pagination": {
          "$ref": "#/definitions/ConfigHistoryPagination"
        }
      }
    },
    "ConfigHistoryItem": {
      "type": "object",
      "required": [
        "id",
        "config",
        "version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Configuration ID"
        },
        "config": {
          "$ref": "#/definitions/StripeConfigurationWithIDs"
        },
        "version": {
          "type": "string",
          "description": "Configuration version"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp"
        },
        "parse_error": {
          "type": "string",
          "nullable": true,
          "description": "Parse error if configuration is invalid"
        }
      }
    },
    "ConfigHistoryPagination": {
      "type": "object",
      "required": [
        "total",
        "page",
        "per_page",
        "total_pages",
        "has_next",
        "has_prev"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "format": "int64",
          "description": "Total number of configurations"
        },
        "page": {
          "type": "integer",
          "description": "Current page number"
        },
        "per_page": {
          "type": "integer",
          "description": "Items per page"
        },
        "total_pages": {
          "type": "integer",
          "description": "Total pages"
        },
        "has_next": {
          "type": "boolean",
          "description": "Whether there is a next page"
        },
        "has_prev": {
          "type": "boolean",
          "description": "Whether there is a previous page"
        }
      }
    },
    "StripeIDConversionResponse": {
      "type": "object",
      "required": [
        "stripe_id",
        "config_id",
        "item_type",
        "config_uuid",
        "history_count"
      ],
      "properties": {
        "stripe_id": {
          "type": "string",
          "description": "Stripe ID"
        },
        "config_id": {
          "type": "string",
