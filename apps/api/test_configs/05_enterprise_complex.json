{
  "$schema": "../internal/static/stripe-config-schema.json",
  "version": "v2.0.0",
  "meters": [
    {
      "id": "analytics_events",
      "display_name": "Analytics Events",
      "event_name": "analytics_event",
      "default_aggregation": {
        "formula": "sum"
      }
    },
    {
      "id": "processing_units",
      "display_name": "Processing Units",
      "event_name": "processing_unit_usage",
      "default_aggregation": {
        "formula": "sum"
      }
    },
    {
      "id": "cdn_bandwidth",
      "display_name": "CDN Bandwidth (GB)",
      "event_name": "cdn_bandwidth_usage",
      "default_aggregation": {
        "formula": "sum"
      }
    },
    {
      "id": "cdn_requests",
      "display_name": "CDN Requests",
      "event_name": "cdn_request",
      "default_aggregation": {
        "formula": "sum"
      }
    }
  ],
  "products": [
    {
      "id": "enterprise_platform",
      "name": "Enterprise Platform",
      "description": "Complete enterprise solution with base subscription and usage-based add-ons",
      "type": "service",
      "prices": [
        {
          "id": "enterprise_base_monthly",
          "amount": 49999,
          "currency": "usd",
          "interval": "month"
        },
        {
          "id": "enterprise_base_yearly",
          "amount": 499999,
          "currency": "usd",
          "interval": "year"
        },
        {
          "id": "enterprise_base_monthly_eur",
          "amount": 44999,
          "currency": "eur",
          "interval": "month"
        }
      ]
    },
    {
