    {
      "id": "workers_cpu_cost",
      "display_name": "Cloudflare Workers CPU Cost (USD)",
      "event_name": "workers_cpu_cost",
      "default_aggregation": {
        "formula": "last"
      }
    }
  ],
  "products": [
