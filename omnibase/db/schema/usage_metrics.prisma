model usage_metrics {
    id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    start_time         DateTime  @db.Timestamptz(6)
    end_time           DateTime  @db.Timestamptz(6)
    project_id         String    @db.Uuid
    project_group_id   String    @db.Uuid
    tenant_id          String    @db.Uuid
    storage_bytes      Decimal?  @db.Decimal(20, 2)
    storage_operations BigInt?
    db_storage_gb      Decimal?  @db.Decimal(12, 4)
    db_compute_hours   Decimal?  @db.Decimal(12, 4)
    email_sends        Int?
    workers_requests   BigInt?
    workers_cpu_ms     BigInt?
    created_at         DateTime? @default(now()) @db.Timestamptz(6)

    @@unique([project_id, start_time, end_time])
    @@index([end_time(sort: Desc)])
    @@index([tenant_id, end_time(sort: Desc)])
    @@index([project_group_id, end_time(sort: Desc)])
    @@index([project_id, end_time(sort: Desc)])
    @@index([start_time])
    @@schema("public")
}
