model clusters {
    id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    label          String
    region         String
    provider       cluster_provider @default(vks)
    vultr_id       String?
    error_message  String?
    error_metadata Json?
    status         cluster_status @default(provisioning)

    created_at DateTime @default(now()) @db.Timestamptz(6)
    updated_at DateTime @default(now()) @db.Timestamptz(6)

    project_branches project_branches[]

    @@index([region], map: "idx_clusters_region")
    @@index([status], map: "idx_clusters_status")
    @@unique([label], map: "clusters_label_key")
    @@schema("public")
}

enum cluster_status {
    provisioning
    active
    maintenance
    failed
    deleted

    @@schema("public")
}

enum cluster_provider {
    vks
    ovh

    @@schema("public")
}
