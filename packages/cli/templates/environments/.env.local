# OmniBase API Configuration
OMNIBASE_API_URL=http://localhost:8080
OMNIBASE_SERVICE_KEY=VERY_SECRET_KEY

# Required: Auth Configuration
WEBSITE_URL=http://127.0.0.1:3000
COOKIE_SECRET=PLEASE-CHANGE-ME-I-AM-VERY-INSECURE
CIPHER_SECRET=32-LONG-SECRET-NOT-SECURE-AT-ALL

# Stripe Configuration (update with your keys)
STRIPE_SECRET_KEY=stripe-secret-key
STRIPE_PUBLISHABLE_KEY=stripe-publishable-key

# Optional: Uncomment and customize as needed
# Auth URLs (defaults shown)
# AUTH_LOG_LEVEL=info
# AUTH_URL=http://127.0.0.1:4433
# AUTH_ADMIN_URL=http://kratos:4434

# Website Auth Flow URLs (all default to ${WEBSITE_URL}/auth/<flow>)
# WEBSITE_AUTH_ERROR_URL=http://127.0.0.1:3000/auth/error
# WEBSITE_SETTING_URL=http://127.0.0.1:3000/auth/settings
# WEBSITE_RECOVERY_URL=http://127.0.0.1:3000/auth/recovery
# WEBSITE_VERIFICATION_RECOVERY_URL=http://127.0.0.1:3000/auth/verification
# WEBSITE_LOGIN_URL=http://127.0.0.1:3000/auth/login
# WEBSITE_REGISTRATION_URL=http://127.0.0.1:3000/auth/registration

# SMTP Configuration
# SMTP_CONNECTION_URI=smtps://test:test@mailslurper:1025/?skip_ssl_verify=true

# OIDC Provider Configuration
# OIDC_GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
