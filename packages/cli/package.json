{
  "name": "@omnibase/cli",
  "version": "0.0.1",
  "description": "OmniBase CLI - Manage Docker Compose services and environment configuration",
  "main": "dist/index.js",
  "bin": {
    "omnibase": "./dist/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "docker/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "NODE_ENV=development bun src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "cli",
    "docker",
    "compose",
    "omnibase"
  ],
  "author": "Phoenix Solutions Group",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "@ory/client": "^1.14.3",
    "jszip": "^3.10.1",
    "form-data": "^4.0.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "@types/bun": "latest"
  }
}
