{
  "name": "omni-base",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "generate:openapi": "./scripts/bundle-openapi.sh",
    "generate:sdk": "./scripts/generate-sdk.sh",
    "generate:docs": "bun ./scripts/generate-docs.ts",
    "generate:docs:typedoc": "bun ./scripts/generate-docs.ts --typedoc",
    "generate:docs:openapi": "bun ./scripts/generate-docs.ts --openapi",
    "test": "./scripts/test-all.sh",
    "test:api": "make -C apps/api test",
    "prepush": "bash .husky/pre-push",
    "prepare": "husky",
    "release:preview": "./scripts/preview-releases.sh"
  },
  "devDependencies": {
    "@grafana/openapi-to-k6": "^0.3.2",
    "@openapitools/openapi-generator-cli": "^2.27.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@types/bun": "latest",
    "fumadocs-core": "^16.2.0",
    "fumadocs-openapi": "^10.2.3",
    "husky": "^9.1.7",
    "prisma": "6.19.3",
    "semantic-release": "^25.0.2",
    "semantic-release-commit-filter": "^1.0.2",
    "typedoc": "^0.28.5",
    "typedoc-plugin-markdown": "^4.6.3"
  },
  "workspaces": [
    "sdk/*/*",
    "packages/*"
  ],
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "yaml": "^2.8.2"
  }
}
