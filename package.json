{
  "name": "omni-base",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "generate:openapi": "./scripts/bundle-openapi.sh",
    "generate:sdk": "./scripts/generate-sdk.sh",
    "generate:docs": "bun ./scripts/generate-docs.ts",
    "generate:docs:typedoc": "bun ./scripts/generate-docs.ts --typedoc",
    "generate:docs:openapi": "bun ./scripts/generate-docs.ts --openapi",
    "generate:k6": "./scripts/generate-k6-sdk.sh",
    "test:api": "./scripts/test-api.sh",
    "test:api:local": "./scripts/test-api.sh --local",
    "test:api:k6": "./scripts/test-api.sh --k6-only --local",
    "test:api:contract": "./scripts/test-api.sh --contract-only --local",
    "release:preview": "./scripts/preview-releases.sh"
  },
  "devDependencies": {
    "@grafana/openapi-to-k6": "^0.3.2",
    "fumadocs-core": "^16.2.0",
    "fumadocs-openapi": "^10.2.3",
    "typedoc": "^0.28.5",
    "typedoc-plugin-markdown": "^4.6.3",
    "@openapitools/openapi-generator-cli": "^2.27.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@types/bun": "latest",
    "semantic-release": "^25.0.2",
    "semantic-release-commit-filter": "^1.0.6"
  },
  "workspaces": [
    "sdk/*/*",
    "tests/test-apps/*",
    "packages/*"
  ],
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@redocly/cli": "^2.14.3",
    "yaml": "^2.8.2"
  },
  "overrides": {
    "find-up": "5.0.0"
  }
}
